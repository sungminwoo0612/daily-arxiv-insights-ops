# Supabase
SUPABASE_URL=...
SUPABASE_KEY=...

# Google Gemini API
GOOGLE_API_KEY=...

# OpenAI API
OPENAI_API_KEY=sk-proj-...

# LangChain 설정
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=

# ArXiv 설정
ARXIV_QUERY=cat:cs.AI AND ("Large Language Models" OR "RAG")
ARXIV_MAX_RESULTS=3

# 데이터 저장 경로
DATA_LAKE_BASE_PATH=data/raw
VECTOR_DB_PATH=data/vectordb
VECTOR_DB_COLLECTION_NAME=arxiv_papers

# API 설정
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RAG 설정
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2
RAG_N_RESULTS=3

# 임베딩 모델 설정
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Reranker 설정
COHERE_API_KEY=your_cohere_key  # https://dashboard.cohere.com/api-keys
RERANKER_STRATEGY=hybrid  # "cohere", "bge", "hybrid", "cascade", "none"
BGE_DEVICE=cuda  # 또는 "cpu" (CPU는 매우 느림)
