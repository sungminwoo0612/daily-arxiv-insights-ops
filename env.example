# --- OpenAI API ---
OPENAI_API_KEY=sk-proj-your-key-here

# --- LangChain Tracing (선택사항) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-key-here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=personal-research-copilot

# --- Cohere Reranker (선택사항) ---
COHERE_API_KEY=your-cohere-key-here

# --- Core Retrieval 설정 ---
ARXIV_QUERY=cat:cs.AI AND ("RAG" OR "Agents")
ARXIV_MAX_RESULTS=5
RERANKER_STRATEGY=none
ENABLE_RERANKER=false
ENABLE_WEB_FALLBACK=false
USE_LLM_NOTE_ENRICHMENT=false

# --- Personal Research 설정 ---
RESEARCH_FOCUS_AREAS=retrieval augmented generation,agentic workflows,ai research automation
RESEARCH_EXCLUDE_TOPICS=
RESEARCH_PROGRAM_PATH=research_program.md
DIGEST_MAX_ITEMS=5
LOCAL_CONFIDENCE_THRESHOLD=0.55
